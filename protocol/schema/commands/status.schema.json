{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/commands/status.schema.json",
  "title": "status command",
  "description": "Args and result for status (level: View).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "result"
  ],
  "properties": {
    "args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "maxProperties": 0
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "battery",
        "screen_on",
        "controller",
        "queue",
        "shizuku"
      ],
      "properties": {
        "device": {
          "type": "string",
          "description": "Device display name, e.g. Pixel 9."
        },
        "battery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Battery level in percent."
        },
        "screen_on": {
          "type": "boolean"
        },
        "controller": {
          "type": [
            "string",
            "null"
          ],
          "description": "peer_id of the bot in control, or null when nobody is."
        },
        "queue": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "peer_ids waiting for control, in FIFO order."
        },
        "shizuku": {
          "type": "boolean",
          "description": "True when the Shizuku service is alive."
        }
      }
    }
  },
  "$defs": {}
}
