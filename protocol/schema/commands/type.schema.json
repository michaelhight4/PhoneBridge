{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/commands/type.schema.json",
  "title": "type command",
  "description": "Args and result for type (level: Control).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "result"
  ],
  "properties": {
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "maxProperties": 0
    }
  },
  "$defs": {}
}
