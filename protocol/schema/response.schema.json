{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/response.schema.json",
  "title": "ApplicationResponse",
  "description": "E2E application response from device to bot.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok", "result"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "ok": { "const": true },
        "result": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok", "error"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "permission_denied",
                "not_controller",
                "busy",
                "bad_args",
                "unknown_cmd",
                "peer_offline",
                "accessibility_disabled",
                "projection_denied",
                "shizuku_unavailable",
                "timeout",
                "internal"
              ]
            },
            "message": { "type": "string" }
          }
        }
      }
    }
  ]
}
