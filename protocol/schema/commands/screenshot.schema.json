{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/commands/screenshot.schema.json",
  "title": "screenshot command",
  "description": "Args and result for screenshot (level: View).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "result"
  ],
  "properties": {
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 16384
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "width",
        "height"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "data_b64": {
          "type": "string",
          "description": "The image, base64url, when it fits in one message."
        },
        "chunked": {
          "type": "boolean",
          "description": "True when the pixels arrive as chunk events keyed by chunk_id."
        },
        "chunk_id": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "Lowercase hex SHA-256 of the whole payload."
        }
      }
    }
  },
  "$defs": {}
}
