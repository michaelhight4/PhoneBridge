{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/envelope.schema.json",
  "title": "RelayEnvelope",
  "description": "Plaintext relay framing envelope. The relay can route it but cannot read E2E payloads. Every message type uses its own subset of the fields; docs/PROTOCOL.md section 3 is normative.",
  "oneOf": [
    { "$ref": "#/$defs/challengeEnvelope" },
    { "$ref": "#/$defs/helloEnvelope" },
    { "$ref": "#/$defs/helloOkEnvelope" },
    { "$ref": "#/$defs/routeEnvelope" },
    { "$ref": "#/$defs/pingEnvelope" },
    { "$ref": "#/$defs/pongEnvelope" },
    { "$ref": "#/$defs/errorEnvelope" },
    { "$ref": "#/$defs/relayMovedEnvelope" },
    { "$ref": "#/$defs/pairStoreEnvelope" },
    { "$ref": "#/$defs/pairStoredEnvelope" },
    { "$ref": "#/$defs/pairLookupEnvelope" },
    { "$ref": "#/$defs/pairOfferEnvelope" }
  ],
  "$defs": {
    "peerId": {
      "type": "string",
      "pattern": "^[0-9abcdefghjkmnpqrstvwxyz]{26}$",
      "description": "Crockford base32 (no i, l, o, u) of the first 16 bytes of SHA-256(public key), lowercase, no padding."
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$",
      "description": "base64url without padding (docs/PROTOCOL.md section 1)."
    },
    "shortCode": {
      "type": "string",
      "pattern": "^[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{3}-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{3}$"
    },
    "challengeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "nonce", "relay_pub", "relay_id"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "challenge" },
        "nonce": { "$ref": "#/$defs/base64url" },
        "relay_pub": { "$ref": "#/$defs/base64url" },
        "relay_id": { "$ref": "#/$defs/peerId" },
        "proof": { "type": "string", "minLength": 1 },
        "expires": { "type": "integer" }
      }
    },
    "helloEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "from", "pub", "sig", "role", "nonce"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "hello" },
        "from": { "$ref": "#/$defs/peerId" },
        "pub": { "$ref": "#/$defs/base64url" },
        "sig": { "$ref": "#/$defs/base64url" },
        "role": { "enum": ["device", "bot"] },
        "nonce": { "$ref": "#/$defs/base64url" },
        "move_token": { "type": "string", "minLength": 1 },
        "id": { "$ref": "#/$defs/uuid" },
        "to": { "$ref": "#/$defs/peerId" }
      }
    },
    "helloOkEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "to", "relay_id", "server_time"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "hello_ok" },
        "to": { "$ref": "#/$defs/peerId" },
        "relay_id": { "$ref": "#/$defs/peerId" },
        "peer": { "$ref": "#/$defs/peerId" },
        "server_time": { "type": "integer" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_envelope_bytes": { "type": "integer", "minimum": 1 },
            "rate_messages": { "type": "integer", "minimum": 1 },
            "rate_window_ms": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "routeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "from", "to", "id", "payload"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "route" },
        "from": { "$ref": "#/$defs/peerId" },
        "to": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "payload": { "$ref": "#/$defs/base64url" }
      }
    },
    "pingEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "from", "id"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "ping" },
        "from": { "$ref": "#/$defs/peerId" },
        "to": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "payload": { "$ref": "#/$defs/base64url" }
      }
    },
    "pongEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "pong" },
        "from": { "$ref": "#/$defs/peerId" },
        "to": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "payload": { "$ref": "#/$defs/base64url" }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "error"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "error" },
        "from": { "$ref": "#/$defs/peerId" },
        "to": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" }
          }
        }
      }
    },
    "relayMovedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "new_url", "expires"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "relay_moved" },
        "from": { "$ref": "#/$defs/peerId" },
        "to": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "new_url": { "type": "string", "minLength": 1 },
        "token": { "type": "string" },
        "expires": { "type": "integer" }
      }
    },
    "pairStoreEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "from", "code", "offer"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "pair_store" },
        "from": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "code": { "$ref": "#/$defs/shortCode" },
        "offer": { "$ref": "https://phonebridge.dev/schema/pairing-offer.schema.json" }
      }
    },
    "pairStoredEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "to", "code"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "pair_stored" },
        "to": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "code": { "$ref": "#/$defs/shortCode" },
        "expires": { "type": "integer" }
      }
    },
    "pairLookupEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "from", "code"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "pair_lookup" },
        "from": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "code": { "$ref": "#/$defs/shortCode" }
      }
    },
    "pairOfferEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "to", "code", "offer"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "pair_offer" },
        "to": { "$ref": "#/$defs/peerId" },
        "id": { "$ref": "#/$defs/uuid" },
        "code": { "$ref": "#/$defs/shortCode" },
        "offer": { "$ref": "https://phonebridge.dev/schema/pairing-offer.schema.json" },
        "expires": { "type": "integer" }
      }
    }
  }
}
