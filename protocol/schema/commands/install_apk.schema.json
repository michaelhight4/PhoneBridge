{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/commands/install_apk.schema.json",
  "title": "install_apk command",
  "description": "Args and result for install_apk (level: Full).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "result"
  ],
  "properties": {
    "args": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_b64",
            "name"
          ],
          "properties": {
            "data_b64": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {}
}
