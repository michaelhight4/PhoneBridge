{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/commands/screenshot.schema.json",
  "title": "screenshot command",
  "description": "Args and result for screenshot (level: View).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "result"
  ],
  "properties": {
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "width",
        "height",
        "data_b64"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "data_b64": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {}
}
