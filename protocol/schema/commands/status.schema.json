    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "battery",
        "screen_on",
        "controller",
        "queue",
        "shizuku"
      ],
      "properties": {
        "device": {
          "type": "object"
        },
        "battery": {
          "type": "object"
        },
        "screen_on": {
          "type": "boolean"
        },
        "controller": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "shizuku": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {}
}
