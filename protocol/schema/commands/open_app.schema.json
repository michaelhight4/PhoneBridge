{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/commands/open_app.schema.json",
  "title": "open_app command",
  "description": "Args and result for open_app (level: Control).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "result"
  ],
  "properties": {
    "args": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package"
          ],
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "maxProperties": 0
    }
  },
  "$defs": {}
}
