{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/commands/files.schema.json",
  "title": "files command",
  "description": "Args and result for files (level: Full).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "args",
    "result"
  ],
  "properties": {
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "list",
            "read",
            "write",
            "delete"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "data_b64": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {}
}
