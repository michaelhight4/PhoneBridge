{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonebridge.dev/schema/pair-result.schema.json",
  "title": "PairResult",
  "description": "Device -> bot pairing result after the user approves or denies.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "granted_level"],
      "properties": {
        "v": { "const": 1 },
        "ok": { "const": true },
        "granted_level": { "enum": ["view", "control", "full"] },
        "device_name": { "type": "string", "minLength": 1 },
        "device_id": { "type": "string", "pattern": "^[0-9abcdefghjkmnpqrstvwxyz]{26}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "reason"],
      "properties": {
        "v": { "const": 1 },
        "ok": { "const": false },
        "reason": { "type": "string", "minLength": 1 },
        "device_name": { "type": "string", "minLength": 1 },
        "device_id": { "type": "string", "pattern": "^[0-9abcdefghjkmnpqrstvwxyz]{26}$" }
      }
    }
  ]
}
