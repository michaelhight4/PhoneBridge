<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/approval_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/approval_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/approval_fingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/approval_requested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/approval_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/approval_level_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/approval_levels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/level_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/level_view" />

            <RadioButton
                android:id="@+id/level_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/level_control" />

            <RadioButton
                android:id="@+id/level_full"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/level_full" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/approval_level_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/approval_allow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/action_allow" />

        <Button
            android:id="@+id/approval_deny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_deny" />
    </LinearLayout>
</ScrollView>
